{
    "name": "pxt-nezbot",
    "version": "1.0.0",
    "description": "MakeCode project template for driving the Nezha robot with the DiffDrive extension. Start here to write JavaScript programs that move, turn, and navigate.",
    "license": "MIT",
    "dependencies": {
        "core": "*",
        "nezha-diffdrive": "github:League-Robotics/pxt-nezha-diffdrive#v1.20261004.2",
        "nezbot-calibrate": "github:League-Robotics/pxt-nezbot-calibrate#v0.20261004.3",
        "pxt-PlanetX": "github:elecfreaks/pxt-PlanetX#v1.6.7",
        "microphone": "*",
        "settings": "*"
    },
    "files": [
        "README.md",
        "main.blocks",
        "main.ts"
    ],
    "supportedTargets": [
        "microbit"
    ],
    "preferredEditor": "blocksprj",
    "languageRestriction": "no-python",
    "yotta": {
        "config": {
            "microbit_radio_max_packet_size": 250,
            "device_ble": 0
        }
    },
    "disablesVariants": [
        "mbdal"
    ]
}
