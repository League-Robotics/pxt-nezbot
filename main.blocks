<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="robotName">robot_name</variable>
  </variables>
  <block type="pxt-on-start" x="20" y="20">
    <statement name="HANDLER">
      <block type="variables_set">
        <field name="VAR" id="robotName">robot_name</field>
        <value name="VALUE">
          <shadow type="math_number"><field name="NUM">0</field></shadow>
          <block type="control_device_name"></block>
        </value>
        <next>
          <block type="diffDrive_setupRadioForName">
            <value name="name">
              <shadow type="text"><field name="TEXT"></field></shadow>
              <block type="variables_get"><field name="VAR" id="robotName">robot_name</field></block>
            </value>
            <next>
              <block type="diffDrive_setupWifiForName">
                <value name="name">
                  <shadow type="text"><field name="TEXT"></field></shadow>
                  <block type="variables_get"><field name="VAR" id="robotName">robot_name</field></block>
                </value>
                <next>
                  <block type="diffDrive_setupRobot">
                    <next>
                      <block type="calibrate_setupCalibrations">
                        <next>
                          <block type="calibrate_setupButtons" disabled="true"></block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
