// tsconfig.json — VS Code IntelliSense only. PXT has its own build pipeline
// and nothing here affects what is compiled onto the micro:bit.
//
// Types come from the real extension sources under pxt_modules/, so
// IntelliSense tracks whatever extensions pxt.json installs. pxt-globals.d.ts
// is a pre-setup fallback only; add extensions to pxt.json, not to it.
//
// "noLib": PXT compiles against its own declarations (pxt_modules/core/
// pxt-core.d.ts), not the browser/ES standard library. Loading a standard
// "lib" declares `var Math`, which collides with PXT's `namespace Math` and
// hides Math.constrain, Math.map and friends. pxt-iter.d.ts supplies the
// iterator protocol that for...of needs without a standard lib.
//
// "strict": false because TypeScript 6 defaults it on and PXT's sources
// are not strict-clean.
//
// "module": commonjs rather than none, which TypeScript 6 deprecates; the
// files have no imports, so they stay global scripts.
//
// "target" stays at es2017 or lower: PXT's bundled TypeScript rejects
// newer values (TS6046).
{
  "compilerOptions": {
    "target": "es2017",
    "noLib": true,
    "strict": false,
    "module": "commonjs",
    "noEmit": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "types": []
  },
  "include": [
    "pxt-iter.d.ts",
    "pxt-globals.d.ts",
    "src/*.ts",
    "pxt_modules/*/src/*.ts",
    "pxt_modules/core/*.d.ts",
    "pxt_modules/*/*.ts",
    "pxt_modules/*/src/blocks/*.ts"
  ]
}
